# Copy this file to .env (dev) or .env.production (build) and adjust as needed.
# Vite only exposes variables prefixed VITE_ to client-side code, and only
# reads .env files at build/dev-server start time — restart `npm run dev`
# after changing this.

# Base URL of the Proton_Admin backend API (Web_Backend). Used by
# src/data/universitiesApi.js for the public /api/universities endpoints.
# Defaults to http://localhost:5080 if unset.
VITE_API_BASE_URL=http://localhost:5080
